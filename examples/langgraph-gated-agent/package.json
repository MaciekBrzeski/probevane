{
  "name": "probevane-langgraph-example",
  "private": true,
  "type": "module",
  "description": "A probevane-style gated test-writing agent built on LangGraph.js + LangChain.js",
  "scripts": {
    "start": "tsx src/run.ts",
    "start:ollama": "tsx src/run.ts --ollama",
    "test": "tsx src/agent.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0"
  },
  "devDependencies": {
    "@langchain/ollama": "^0.2.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
