# probevane environment — copy to .env (gitignored) or export in your shell.

# Required for the API brain (generate/eval/ci with --model auto|haiku|sonnet|opus).
# Not needed for --model local:<id> (Ollama/vLLM) or --model bridge.
ANTHROPIC_API_KEY=

# --- Optional: Azure DevOps board integration (probevane ado) ---
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=

# --- Optional: overrides ---
PROBEVANE_MODEL=            # default API model id (else claude-haiku-4-5-…)
PROBEVANE_STATE=            # state root — set per-repo/worker to isolate concurrent runs
PROBEVANE_MAX_INFLIGHT=     # cap concurrent API calls (factory scale; 0/unset = unlimited)
PROBEVANE_BASE_URL=         # OpenAI-compatible endpoint for --model local:<id> (default Ollama :11434/v1)
PROBEVANE_TRACES=           # =1 to record accepted traces + promote to the learning library
PROBEVANE_LEDGER=           # =0 to disable the cost ledger
