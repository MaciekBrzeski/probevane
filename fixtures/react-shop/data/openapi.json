{
  "openapi": "3.0.0",
  "info": { "title": "shop", "version": "1.0.0" },
  "paths": {
    "/api/products": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } }
              }
            }
          }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Product" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "required": ["id", "name", "priceCents", "inStock"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "priceCents": { "type": "integer", "minimum": 0 },
          "inStock": { "type": "boolean" }
        }
      }
    }
  }
}
