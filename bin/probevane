#!/usr/bin/env bash
# Probevane CLI — agentic harness that adds unit + e2e tests to a project.
# Dispatches to src/cli/<command>.ts via tsx. Mirrors qaforge/bin/qaforge.

set -euo pipefail

PROBEVANE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PROBEVANE_ROOT

cmd="${1:-help}"
shift 2>/dev/null || true

# Prefer the compiled dist (published installs ship it, no tsx needed);
# fall back to tsx on the source for dev-from-checkout.
run_cli() {
  local name="$1"
  shift
  if [ -f "$PROBEVANE_ROOT/dist/cli/$name.js" ]; then
    exec node "$PROBEVANE_ROOT/dist/cli/$name.js" "$@"
  else
    exec npx tsx "$PROBEVANE_ROOT/src/cli/$name.ts" "$@"
  fi
}

case "$cmd" in
  init|plan|generate|run|audit|coverage|learn|eval|status|mock|graph|spec|refactor|feature|repair|fix|ci|review|bench|watch|skill|a11y|distill|serve|peek|improve|history|ado|simcost|assert-score|impact|revert|factory|daemon|quality|mfe-audit|mfe-contract|mfe|migrate|document|docs|otel|enqueue|scan|improve-cycle|pipeline|search|mutation|design|arch|doctor|tui)
    # `<cmd> -h/--help` → catalog-driven per-command help. Without this, most
    # subcommands treat the flag as noise and silently run against `.`.
    for a in "$@"; do
      if [ "$a" = "-h" ] || [ "$a" = "--help" ]; then
        run_cli help "$cmd"
      fi
    done
    run_cli "$cmd" "$@"
    ;;
  version|-v|--version)
    node -e "console.log(require('$PROBEVANE_ROOT/package.json').version)"
    ;;
  help|-h|--help)
    # Full index, or `help <cmd>` for one command — rendered from the drift-
    # gated catalog (src/skill/catalog.ts), never a stale heredoc.
    run_cli help "${1:-}"
    ;;
  *)
    echo "probevane: unknown command '$cmd' (try: probevane help)" >&2
    exit 2
    ;;
esac
